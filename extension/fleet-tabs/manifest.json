{
  "manifest_version": 3,
  "key": "",
  "name": "Вкладки флота",
  "version": "0.19.6",
  "description": "Продолжает вкладки web-ChatGPT, которые держат задачу флота dev-mcp, и не даёт им засыпать.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "notifications",
    "scripting",
    "system.memory"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "mode.js",
        "research-content.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Вкладки флота"
  },
  "icons": {
    "128": "icon128.png"
  }
}
